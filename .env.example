# Samsung The Frame on your LAN (find it on your router; the TV must be on)
FRAME_TV_HOST=192.168.1.50
# Its Wi-Fi MAC, so the tool can Wake-on-LAN a 2019 Frame that closed its control ports in Art-Mode sleep
FRAME_TV_MAC=AA:BB:CC:DD:EE:FF
# Optional: your subnet's broadcast address for WoL (255.255.255.255 is always tried too)
# FRAME_WOL_BROADCAST=192.168.1.255
# Where candidates, sheets, the gallery and the manifest live (default ./data)
# FRAME_DATA_DIR=data
# Override the built-in safe search terms with your own, comma-separated
# ART_TERMS=Monet water lilies,Sisley,Dutch landscape
